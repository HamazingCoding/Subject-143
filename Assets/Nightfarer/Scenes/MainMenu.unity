  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: '<b><color=#EED18F>ACTION                         KEYBOARD / MOUSE       
    GAMEPAD</color></b>

    Move / camera                  WASD / Mouse               
    LS / RS

    Dodge (tap) / Sprint (hold)    Space                       B

    Surge
    sprint (while moving)    Left Alt                    L3

    Jump / climb ledge            
    F                           A

    Light attack                   Left mouse                 
    RB

    Heavy attack (hold to charge)  Right mouse                 RT

    Lock
    on / switch target        Q or Middle mouse / flick   R3 / flick RS

    Character
    skill                E                           LT

    Ultimate Art                  
    G                           Y

    Crimson Tears flask            R                          
    X

    Switch weapon                  X                           D-pad right

    Walk
    toggle                    Left Ctrl                   D-pad up

    Pause                         
    Esc                         Start


    Spirit springs: stand in the light and
    press Jump. High falls end in a roll; there is no fall damage.'
